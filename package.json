{
  "name": "for-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "prebuild": "npm run prepare:ocr",
    "predev": "npm run prepare:ocr",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
