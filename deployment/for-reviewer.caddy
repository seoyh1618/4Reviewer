# Install in the existing ingress container's persistent /config/for-reviewer/.
# Its main Caddyfile must import /config/for-reviewer/*.caddy.
# The application/database stay on their own Compose networks and volumes.
forreviwer.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy http://172.18.0.1:18081 {
        header_up Host {host}
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
    # No access log: login tokens and personal fields must not be logged.
}

www.forreviwer.com {
    redir https://forreviwer.com{uri} permanent
}
