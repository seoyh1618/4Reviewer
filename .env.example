# Node.js 24 이상. npm start는 기본 포트 3001에서 실행합니다.
PORT=3001
DATABASE_PATH=./data/reviewer.sqlite
# HTTPS 배포 시 true. 로컬 HTTP 개발 환경에서는 false.
COOKIE_SECURE=false
# 역방향 프록시가 정확히 하나일 때만 1. 기본값 0.
TRUST_PROXY=0
# 브라우저 접속 주소. 설정한 경우 이 Origin만 쓰기 요청 허용.
# APP_ORIGIN=https://reviews.example.com

# PostgreSQL 배포: DATABASE_URL 또는 PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE 설정.
# 둘 다 없으면 기존 로컬 SQLite를 사용합니다.
# DATABASE_URL=postgresql://reviewer_app:CHANGE_ME@127.0.0.1:15432/reviewer
PGSCHEMA=reviewer

# 소셜 로그인: APP_ORIGIN 필수. 비밀 키는 서버에만 저장합니다.
# 각 제공자에 APP_ORIGIN/api/auth/social/{google|kakao|naver}/callback 등록.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Authenticates Kakao's unlink notifications. Never expose in frontend code.
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Comma-separated providers awaiting review; shown only on ?social_preview=provider.
# This controls button visibility only. Provider-side test user restrictions still apply.
SOCIAL_AUTH_PREVIEW_PROVIDERS=
